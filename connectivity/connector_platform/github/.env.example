# GitHub connector — T1
#
# Copy to .env in this directory and fill in. Never commit .env.
#
#   cp connectivity/connector_platform/github/.env.example \
#      connectivity/connector_platform/github/.env

# Fine-grained personal access token, read-only.
# github.com -> Settings -> Developer settings -> Personal access tokens
#   -> Fine-grained tokens -> Generate new token
#
# Repository permissions required, all Read-only:
#   Contents · Issues · Pull requests · Metadata
GITHUB_TOKEN=

# The repository to observe, as owner/name.
GITHUB_REPO=Horquva/OBA-Core-Horquva

# Polling interval in seconds. T1 uses polling, not webhooks.
GITHUB_POLL_INTERVAL=60

# How far back to look on first run, in minutes.
GITHUB_INITIAL_LOOKBACK=60
