# Part R — Negative Test Fixture: Secret Detection
#
# This file intentionally contains a FAKE credential in a real, detectable
# format so the negative-test.yml workflow can prove Gitleaks actually
# blocks on detection. This is NOT a real credential and grants no access
# to anything. Do not "fix" this by removing it — removing it breaks the
# resilience test.
#
# NOTE: deliberately NOT using the well-known AWS-documentation example key
# (AKIAIOSFODNN7EXAMPLE) — some tools' default rulesets are known to treat
# that specific, widely-published string as a recognized placeholder and
# suppress it, which would silently defeat this test. Using a distinct
# fake value avoids that dependency entirely.

FAKE_AWS_ACCESS_KEY_ID = "AKIAZ9X4Q7T2R8M5N1K3"
FAKE_AWS_SECRET_ACCESS_KEY = "zK9mQ2wRfPxT7Lb3VnJhY6sD1cA4eG8uH5oI0pW"
