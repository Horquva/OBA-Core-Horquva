# Part R — Negative Test Fixture: Container Vulnerability Detection
#
# This Dockerfile intentionally uses a very old, known-vulnerable base
# image so the negative-test workflow can prove Trivy actually detects
# and blocks on real Critical/High vulnerabilities. This image is NEVER
# used for anything except this controlled test — it is not part of any
# real service and is never deployed.
#
# alpine:3.9 (released 2019) has multiple well-documented, long-published
# CVEs in its base packages (musl, busybox, openssl), making it a reliable,
# reproducible fixture for this test.

FROM alpine:3.9

RUN echo "This image exists ONLY to prove the container security gate detects real vulnerabilities. Do not build this into any real service."
