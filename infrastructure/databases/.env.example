# OCOS database connection.
#
# Copy to .env and adjust. Never commit .env.
#
#   cp infrastructure/databases/.env.example infrastructure/databases/.env

# --- Development (docker-compose.yml in this directory) ---
PGHOST=localhost
PGPORT=5433
PGUSER=ocos
PGPASSWORD=ocos
PGDATABASE=ocos_dev

# --- Staging ---
# Hosted PostgreSQL on a Horquva-owned account.
# Fill these in from the staging provider. Do not commit the values.
# PGHOST=
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=ocos_staging
