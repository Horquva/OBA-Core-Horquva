# ============================================================
# OBA Backend — Environment Variables (EXAMPLE)
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to git.
# ============================================================

# --- Supabase ---
# Supabase project URL (Project Settings -> API -> Project URL)
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Supabase secret / service-role key (Project Settings -> API)
# Keep this private. Do not expose it in the frontend.
SUPABASE_KEY=your-supabase-secret-key-here

# Port the API server listens on
PORT=3000

# --- Authentication (JWT) ---
# JWT signing secret. Use a long random string. REQUIRED — the server refuses
# to start without it (no insecure fallback).
JWT_SECRET=change-this-to-a-long-random-string

# Comma-separated allowlist of frontend origins allowed to call this API from
# a browser. Defaults to the local dev ports when unset; set this to your
# real deployed frontend origin(s) in production.
# CORS_ORIGINS=https://your-frontend.example.com

# SEC-2: session cookie mode. Leave both unset for local dev (SameSite=Lax over http).
# Deployed behind the frontend's /api proxy (frontend/next.config.ts): keep
# SameSite=Lax and make the cookie HTTPS-only:
# COOKIE_SECURE=true
# Only if the frontend calls the backend directly on another domain (no proxy):
# the cookie becomes SameSite=None; Secure. Some browsers block this.
# COOKIE_CROSS_SITE=true

# Token expiry in seconds (default 3600 = 1 hour)
TOKEN_TTL=3600

# Fallback admin login (MVP/demo). Used when the app_users table is not yet set up.
ADMIN_EMAIL=admin@horquva.com
ADMIN_PASSWORD=change-this-admin-password
ADMIN_ORG=horquva

# ============================================================
# Organizational Agent / Provider
# ============================================================

# Master feature flag. When false, agent routes are not mounted.
AGENT_ENABLED=false

# Provider adapter selection.
# Supported values: gemini, anthropic
AGENT_PROVIDER=gemini

# Provider model ID. Do not hardcode this in source.
# gemini-3.7-flash is listed for this key but returned a consistent 503
# "high demand" from Google as of 2026-09-22 -- gemini-2.5-flash (stable,
# GA) worked immediately against the same key at the same time. Model IDs
# and availability rotate (see the plan's §3.3/§7.1); re-check
# GET https://generativelanguage.googleapis.com/v1beta/models?key=... if
# this starts failing again.
AGENT_MODEL=gemini-2.5-flash

# Provider credentials. Keep these private and never commit .env.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Maximum provider/tool rounds for a single turn.
AGENT_MAX_ITERATIONS=8

# Maximum wall-clock time for a turn, in milliseconds.
AGENT_TURN_TIMEOUT_MS=120000

# Maximum turns per user per day.
AGENT_DAILY_TURN_BUDGET=40
