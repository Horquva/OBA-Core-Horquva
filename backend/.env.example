# ============================================================
# OBA Backend — Environment Variables (EXAMPLE)
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to git.
# ============================================================

# --- Supabase ---
# Supabase project URL (Project Settings -> API -> Project URL)
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Supabase secret / service-role key (Project Settings -> API)
# Keep this private. Do not expose it in the frontend.
SUPABASE_KEY=your-supabase-secret-key-here

# Port the API server listens on
PORT=3000

# --- Authentication (JWT) ---
# JWT signing secret. Use a long random string. Must be changed in production.
JWT_SECRET=change-this-to-a-long-random-string

# Token expiry in seconds (default 3600 = 1 hour)
TOKEN_TTL=3600

# Fallback admin login (MVP/demo). Used when the app_users table is not yet set up.
ADMIN_EMAIL=admin@horquva.com
ADMIN_PASSWORD=change-this-admin-password
ADMIN_ORG=horquva

# ============================================================
# Sentinel Identity & Trust Platform (Owner: Areeb Ahmad)
# Dedicated PostgreSQL database, isolated from the Supabase-backed OBA data.
# ============================================================
IDENTITY_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/oba_identity

# Phase 1 signing is HS256 (symmetric). Rotate per environment; see identity/DECISIONS.md.
IDENTITY_JWT_SECRET=change-me-per-environment
IDENTITY_JWT_ISSUER=sentinel-identity
IDENTITY_JWT_AUDIENCE=horquva-platforms
IDENTITY_ACCESS_TTL=900       # access-token lifetime (seconds) — short-lived
IDENTITY_REFRESH_TTL=604800   # refresh-token lifetime (seconds)
