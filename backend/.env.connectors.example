# Platform credentials for the phase 0 scripts (platformProbe.ts, emailOverlap.ts)
# and later live runs. Copy to backend/.env.connectors, which is gitignored.
# Names only here: never commit values. The scripts print statuses, not values.

# Microsoft Entra ID (app registration with application permissions)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# n8n (public API key)
N8N_BASE_URL=
N8N_API_KEY=

# Slack (bot token, xoxb-)
SLACK_BOT_TOKEN=

# Jira Cloud (site name such as "acme", or acme.atlassian.net)
JIRA_SITE=
JIRA_EMAIL=
JIRA_API_TOKEN=

# GitHub: personal access token and/or GitHub App
GITHUB_ORG=
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
