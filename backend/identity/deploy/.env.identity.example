# Sentinel Identity & Trust — deployment env (EXAMPLE). Copy to .env.identity and fill in.
# .env.identity is gitignored. Generate the signing/encryption secrets with:
#   node identity/deploy/generate-secrets.js >> .env.identity

# --- Database ---
# Bundled Postgres (docker-compose default). For managed Postgres (e.g. Supabase),
# set the full connection string and remove the `db` service from docker-compose.yml.
POSTGRES_USER=identity
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=oba_identity
IDENTITY_DATABASE_URL=postgresql://identity:change-me-strong@db:5432/oba_identity

# Host port to expose the service on.
IDENTITY_PORT=3000

# --- Token signing (RS256 recommended for cross-service verification) ---
# Fill these from generate-secrets.js. For HS256 instead, set IDENTITY_JWT_SECRET
# and leave ALG=HS256 (JWKS will be empty; consumers verify by calling the platform).
IDENTITY_JWT_ALG=RS256
IDENTITY_JWT_KID=rsa-YYYY-MM-DD-xxxxxx
IDENTITY_JWT_PRIVATE_KEY=
IDENTITY_JWT_PUBLIC_KEY=
IDENTITY_JWT_SECRET=
IDENTITY_JWT_ISSUER=sentinel-identity
IDENTITY_JWT_AUDIENCE=horquva-platforms
IDENTITY_ACCESS_TTL=900
IDENTITY_REFRESH_TTL=604800

# --- Secrets-Service encryption key (64 hex chars) ---
IDENTITY_SECRETS_ENC_KEY=

# --- Bootstrap admin (seed) — CHANGE for a real environment ---
SEED_ADMIN_EMAIL=admin@horquva.io
SEED_ADMIN_PASSWORD=change-me-admin-strong
SEED_ORG_SLUG=horquva
