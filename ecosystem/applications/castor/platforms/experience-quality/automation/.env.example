# Experience Quality Automation - Environment Configuration
# Copy this file to .env and fill in real values locally. Never commit .env.

# Base URL of the application under test.
# Placeholder until the real Castor application environment is provisioned.
BASE_URL=http://localhost:3000

# Optional: environment label used in reporting (local | staging | production)
TEST_ENV=local

# Optional: default timeout overrides (milliseconds)
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=30000
