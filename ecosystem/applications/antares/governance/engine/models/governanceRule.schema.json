{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "governanceRule.schema.json",
  "title": "GovernanceRule",
  "description": "A static, human-authored policy rule. Answers: is this action allowed at all?",
  "type": "object",
  "required": ["id", "name", "appliesTo", "requirement", "severity", "active"],
  "properties": {
    "id": { "type": "string", "pattern": "^R-[0-9]+$", "description": "e.g. R-09" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "appliesTo": {
      "type": "object",
      "required": ["actions"],
      "properties": {
        "actions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "actorRoles": { "type": "array", "items": { "type": "string" } },
        "resourceTypes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "requirement": {
      "type": "string",
      "enum": ["ALLOW_IF_MATCH", "REJECT_IF_MATCH", "REQUIRE_HUMAN_REVIEW_IF_MATCH", "CONDITIONAL"]
    },
    "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "active": { "type": "boolean" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
