    H --> I["🔍 Discoverable<br/>& Searchable"]
    I --> J["👥 Used by<br/>Teams"]
    
    J --> K{"📅 Review<br/>Cycle?"}
    
    K -->|Needs Update| L["♻️ Refresh<br/>Content"]
    L --> D
    
    K -->|Obsolete| M["📦 Archive<br/>with Rationale"]
    M --> N["🗂️ Archived<br/>Knowledge"]
    
    K -->|Still Current| O["✓ Mark<br/>as Current"]
    O --> J
    
    J --> P["📈 Metrics<br/>Tracked"]
    P --> Q["🎯 Measure<br/>Impact"]

