# Copy this file to .env.local and fill in your real values.
# NEVER commit the real .env.local file to git.

# Backend API origin. Point this at wherever backend/ is actually running --
# with autoPort enabled in .claude/launch.json, the backend commonly lands
# on a port other than 3000, so check its startup log ("Server running on
# port ...") and match it here, then restart this dev server.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Hides the agent panel entirely when false. Only meaningful if the backend
# also has AGENT_ENABLED=true and a working provider key -- see
# backend/.env.example's Organizational Agent section.
NEXT_PUBLIC_AGENT_ENABLED=false
