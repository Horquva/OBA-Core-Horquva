# Copy this file to .env.local and fill in your real values.
# NEVER commit the real .env.local file to git.

# Backend API origin. Point this at wherever backend/ is actually running --
# with autoPort enabled in .claude/launch.json, the backend commonly lands
# on a port other than 3000, so check its startup log ("Server running on
# port ...") and match it here, then restart this dev server.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Dev sign-in: in `next dev`, the app signs in automatically through the
# backend's POST /api/auth/dev/sign-in (backend needs AUTH_DEV_LOGIN=true).
# Each role signs in as a real test-org user. The account must exist in the
# backend (npm run user:bootstrap -- --email ... --role ...). A role left
# empty is not offered; with none set, dev sign-in shows an error.
NEXT_PUBLIC_DEV_ADMIN_EMAIL=
NEXT_PUBLIC_DEV_REVIEWER_EMAIL=
NEXT_PUBLIC_DEV_VIEWER_EMAIL=
# Optional: the starting role (must have an email above).
# NEXT_PUBLIC_DEV_ROLE=admin

# Hides the agent panel entirely when false. Only meaningful if the backend
# also has AGENT_ENABLED=true and a working provider key -- see
# backend/.env.example's Organizational Agent section.
NEXT_PUBLIC_AGENT_ENABLED=false
